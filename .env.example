# Groq free tier: ATLAS_LLM_PROVIDER=openai, LLM_BASE_URL=https://api.groq.com/openai/v1,
# ATLAS_MODEL=openai/gpt-oss-120b, ATLAS_REASONING_EFFORT=low, ATLAS_MAX_REQUEST_TOKENS=7000,
# ATLAS_MAX_OUTPUT_TOKENS=1024
ATLAS_LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ATLAS_MODEL=gemini-3.5-flash
ATLAS_MAX_REQUEST_TOKENS=
ATLAS_REASONING_EFFORT=
ATLAS_K=8
ATLAS_EMBED_MODEL=BAAI/bge-small-en-v1.5
ATLAS_APPROVE_WRITES=true
ATLAS_PRICE_IN_PER_M=0
ATLAS_PRICE_OUT_PER_M=0

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlas
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
ATLAS_TOOLS_COLLECTION=atlas_tools
ATLAS_KB_COLLECTION=atlas_kb
